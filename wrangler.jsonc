// Configuration Cloudflare Workers (déployée automatiquement à chaque push sur main).
{
  "name": "best-tools-vibecoding-v1",
  "main": "src/worker.js",
  "compatibility_date": "2025-07-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/api/*", "/auth/*", "/c/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vibe-ratings",
      "database_id": "a90b26da-47ee-43cc-8eb0-fdb21ce7e90f"
    }
  ],
  // Identifiants GitHub NUMÉRIQUES des administrateurs (séparés par des virgules). Ce n'est pas un secret.
  // 80370810 = johnapplewan. L'identifiant ne change jamais, même si le compte est renommé.
  "vars": { "ADMIN_GITHUB_IDS": "80370810" },
  // Garde les variables ajoutées dans le tableau de bord Cloudflare à chaque déploiement.
  "keep_vars": true,
  "observability": { "enabled": true }
}
